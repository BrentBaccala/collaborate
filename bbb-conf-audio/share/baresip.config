module_path             /usr/lib/baresip/modules
sip_listen              0.0.0.0:0
# --- audio: capture the virtual mic (fed by VLC), play conf audio into a dead-end sink ---
audio_player            pulse,desktop_out
audio_source            pulse,virtmic
audio_alert             pulse,desktop_out
ausrc_srate             48000
auplay_srate            48000
# --- modules ---
module                  pulse.so
module                  opus.so
module                  g711.so
module                  account.so
module                  menu.so
# ctrl_tcp deliberately NOT loaded.  Nothing here uses it, and its default is
# `ctrl_tcp_listen 0.0.0.0:4444` (baresip's own example config) -- so merely
# loading it would (a) expose a JSON control interface for this user's baresip
# on every interface, where anyone who can reach the port could dial or hang up
# calls, and (b) collide between users, since the second desktop's baresip
# cannot bind a port the first already holds.
# If call-state detection is added later (see README, "is my injector still
# connected?"), re-enable it WITH an explicit per-user localhost port:
#     module              ctrl_tcp.so
#     ctrl_tcp_listen     127.0.0.1:<4444 + uid offset>
opus_bitrate            64000
