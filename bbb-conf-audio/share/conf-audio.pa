#!/usr/bin/pulseaudio -nF
# bbb-conf-audio: the per-user PulseAudio startup script, copied to
# ~/.config/pulse/default.pa by `conf-audio setup`.
#
# Deliberately a two-line stub.  A user's ~/.config/pulse/default.pa REPLACES
# /etc/pulse/default.pa rather than merging with it (default.pa(5): "when
# ~/.config/pulse/default.pa exists, that file is used"), so:
#
#   - the first include puts the stock system configuration back, without which
#     the session would come up with the virtual devices and no real ones --
#     no udev detection, no ALSA cards, nothing;
#   - the second include pulls in our devices from a package-owned file, so
#     that changing the device set in a later release reaches users who have
#     already run setup.  Inlining those lines here instead would freeze them
#     into every user's home directory at the version they first ran.
#
# A missing second include is not fatal (tested): if the package is removed,
# PulseAudio still starts and simply lacks the virtual devices.

.include /etc/pulse/default.pa
.include /usr/share/bbb-conf-audio/conf-audio-modules.pa
