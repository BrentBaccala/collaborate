location /vnc {
        proxy_pass http://localhost:6102;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 6h;
        proxy_send_timeout 6h;
        client_body_timeout 6h;
        send_timeout 6h;

        # No auth_request here, deliberately.  The /vnc token check lives in
        # websockify's new_websocket_client (it calls checkAuthorization on
        # loopback itself and reads User-Id/Meeting-Id off that response).
        # auth_request is binary -- it can only 401, which reaches the browser
        # as a bare WS close 1006 and paints a blank panel with no explanation.
        # Checking past the 101 instead lets an expired token be refused at the
        # RFB layer with a reason string the remote-desktop plugin displays.
        # Re-adding auth_request here silently shadows that path: the check
        # still passes, but the user loses the message.
}
