#!/usr/bin/python3
#
# Read or write the current contents of Big Blue Button's "Shared
# Notes" in either text or HTML format.

import os
import sys
import argparse
import requests
from urllib.parse import urlencode, quote_plus

import subprocess
import bigbluebutton

parser = argparse.ArgumentParser(description='Read and write the shared notes of a Big Blue Button meeting')
parser.add_argument('-t', '--text', action="store_true",
                    help='output in text format')
parser.add_argument('-r', '--read', '--get', action="store_true", help="read from shared notes")
parser.add_argument('-w', '--write', '--set', action="store_true", help="write to shared notes")
parser.add_argument('-m', '--meeting', action='store', help='meeting name (only needed if multiple meetings are running)')
parser.add_argument('infile', nargs='?', help="file to write to shared notes")
args = parser.parse_args()

if (args.read and args.write) or (not args.read and not args.write):
   print("Exactly one of --read (-r) or --write (-w) must be specified\n")
   parser.print_help()
   exit()

if args.read and args.infile:
   print("file not supported with --read option\n")
   parser.print_help()
   exit()

# Get the internal meeting ID

xml = bigbluebutton.getMeetings()

if args.meeting:
   matchingMeetingIDs = xml.xpath('.//meetingName[text()=$name]/../internalMeetingID', name=args.meeting)
   if len(matchingMeetingIDs) == 0:
      print("Can't find a Big Blue Button meeting of that name\n")
      parser.print_help()
      exit(1)
   if len(matchingMeetingIDs) > 1:
      print("Can't find a unique Big Blue Button meeting of that name\n")
      parser.print_help()
      exit(1)
   meetingID = matchingMeetingIDs[0]
else:
   allMeetingIDs = xml.xpath('.//internalMeetingID')
   if len(allMeetingIDs) == 0:
      print("Can't find a running Big Blue Button meeting\n")
      parser.print_help()
      exit(1)
   if len(allMeetingIDs) != 1:
      print("Can't find a unique Big Blue Button meeting\n")
      parser.print_help()
      exit(1)
   meetingID = allMeetingIDs[0]

# Pick a joined user to attribute writes to.  Etherpad setText/setHTML must
# carry an authorId that bbb-pads maps to a real BBB user; an anonymous write
# is attributed to a non-existent "system" user, and the insert into the
# sharedNotes_rev table (which feeds *locked* viewers) then fails a foreign-key
# constraint, so locked students never see the notes.  Unlocked users read the
# live Etherpad pad directly and are unaffected.  Prefer a moderator; fall back
# to any attendee.  (Taken from the getMeetings XML we already fetched, so no
# extra database grant is needed.)
meetingElem = meetingID.getparent()
attributionUserIDs = (meetingElem.xpath('.//attendee[role="MODERATOR"]/userID/text()')
                      or meetingElem.xpath('.//attendee/userID/text()'))
attributionUserID = attributionUserIDs[0] if attributionUserIDs else None

# Lookup the meeting in PostgreSQL and retrieve the padID.
# Uses the unprivileged 'bbb_query' role (SELECT-only on sharedNotes)
# created by /usr/sbin/bbb-shared-notes-setup at install time, so this
# script does not need root.

env = {**os.environ, 'PGPASSWORD': 'bbbquery'}
result = subprocess.run(
   ['psql', '-h', '127.0.0.1', '-U', 'bbb_query', '-d', 'bbb_graphql', '-t', '-A',
    '-c', f"SELECT \"padId\" FROM \"sharedNotes\" WHERE \"meetingId\" = '{meetingID.text}' LIMIT 1"],
   capture_output=True, text=True, env=env
)
if result.returncode != 0:
   err = result.stderr.strip()
   if 'role "bbb_query" does not exist' in err or 'authentication failed' in err:
      print("bbb-shared-notes: postgres role 'bbb_query' is not configured", file=sys.stderr)
      print("  Run: sudo bbb-shared-notes-setup", file=sys.stderr)
   elif 'permission denied for table' in err:
      # A BBB upgrade that recreates the sharedNotes table drops the
      # table-level GRANT, so the bbb_query role can still connect but
      # has lost SELECT.  Re-running the setup re-grants it.
      print("bbb-shared-notes: bbb_query role has lost SELECT on sharedNotes", file=sys.stderr)
      print("  (a BBB upgrade likely recreated the table) — run: sudo bbb-shared-notes-setup", file=sys.stderr)
   else:
      print("Can't query shared notes pad for this meeting", file=sys.stderr)
      if err:
         print(err, file=sys.stderr)
   exit(1)
if not result.stdout.strip():
   print("Can't find shared notes pad for this meeting", file=sys.stderr)
   exit(1)
padID = result.stdout.strip()

# Get the APIKEY used to communicate with the Etherpad server.

with open("/usr/share/etherpad-lite/APIKEY.txt") as f:
   key = f.read()

# Retrieve the data and print it

if args.read:
   payload = {'apikey' : key, 'padID' : padID}
   result = urlencode(payload, quote_via=quote_plus)
   if args.text:
      url = "http://localhost:9001/api/1/getText?" + result
      key = 'text'
   else:
      url = "http://localhost:9001/api/1/getHTML?" + result
      key = 'html'
   response = requests.get(url)
   response.raise_for_status()
   if response.json()['code'] != 0:
      print(response.json()['message'], file=sys.stderr)
   else:
      print(response.json()['data'][key])

# Retrieve the data and send it to the server

if args.write:
   if args.infile:
      with open(args.infile) as file:
         data = file.read()
   else:
      data = sys.stdin.read()

   # Derive the Etherpad author for the attribution user.  bbb-pads creates
   # each user's Etherpad author with createAuthorIfNotExistsFor(userId), which
   # is deterministic, so this returns the same authorId bbb-pads has already
   # mapped to that user.
   authorId = None
   if attributionUserID:
      payload = {'apikey' : key, 'authorMapper' : attributionUserID}
      response = requests.get("http://localhost:9001/api/1.3.0/createAuthorIfNotExistsFor?"
                              + urlencode(payload, quote_via=quote_plus))
      response.raise_for_status()
      if response.json()['code'] == 0:
         authorId = response.json()['data']['authorID']

   if '<!DOCTYPE HTML>' in data:
      payload = {'apikey' : key, 'padID' : padID, 'html' : data}
      url = "http://localhost:9001/api/1.3.0/setHTML?"
   else:
      payload = {'apikey' : key, 'padID' : padID, 'text' : data}
      url = "http://localhost:9001/api/1.3.0/setText?"

   # /api/1.3.0 is the earliest Etherpad API version whose setText/setHTML
   # accept an authorId; /api/1 silently ignores it (leaving the write
   # anonymous, which is what breaks the locked-viewer path).
   if authorId:
      payload['authorId'] = authorId

   result = urlencode(payload, quote_via=quote_plus)
   response = requests.get(url + result)
   response.raise_for_status()
   if response.json()['code'] != 0:
      print(response.json()['message'], file=sys.stderr)
